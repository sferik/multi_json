# External JSON libraries that the adapters wrap. Declared here as
# untyped stubs so Steep can check the adapter wrappers without
# needing full sigs for libraries that don't ship them.

module JrJackson
  module Json
    def self.load: (untyped string, untyped options) -> untyped
    def self.dump: (untyped object, untyped options) -> String
  end

  class ParseError < StandardError
  end
end

