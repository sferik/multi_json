module MultiJson
  VERSION: String

  DEPRECATION_WARNINGS_SHOWN: Set[Symbol]

  module Concurrency
    DEPRECATION_WARNINGS: Mutex
    ADAPTER: Mutex
    DEFAULT_ADAPTER: Mutex
    DEFAULT_OPTIONS: Mutex
    DUMP_DELEGATE: Mutex
  end



  extend Options
  extend AdapterSelector

  # JSON value type - what load() returns
  type json = nil | bool | Integer | Float | String | Array[json] | Hash[String, json]

  # JSON-serializable input type - what dump() accepts
  type json_input = nil | bool | Integer | Float | String | Symbol | Array[json_input] | Hash[json_key, json_input] | _ToJson

  # Valid hash key types for JSON input
  type json_key = String | Symbol

  # Options hash type
  type options = Hash[Symbol, bool | String | Symbol | Integer | Proc | nil]

  # Adapter specification - can be string name, symbol, module, or nil/false for default
  type adapter_spec = String | Symbol | Module | nil | false

  # Callable options - proc that returns options
  type options_proc = ^() -> options | ^(options) -> options

  # Options input - can be hash or callable
  type options_input = options | options_proc

  # String or IO-like object for load input
  type string_input = String | _Readable

  interface _Readable
    def read: () -> String
  end

  interface _ToJson
    def as_json: () -> json_input
  end

  # Adapter interface - accepts string_input since adapters handle IO internally
  interface _Adapter
    def load: (string_input string, options options) -> json
    def dump: (json_input object, options options) -> String
  end

  # Singleton-only helpers (not module functions)
  private def self.warn_deprecation_once: (Symbol key, String message) -> void
  def self.parse_error_class_for: (untyped adapter_class) -> untyped

  # module_function methods - declared as both self. and instance methods
  def self.default_options=: (options_input value) -> options_input
  def self.default_options: () -> options
  def self.cached_options: (*top) -> void
  def self.reset_cached_options!: (*top) -> void
  def self.default_engine: () -> Symbol
  def self.adapter: () -> _Adapter
  def self.engine: () -> _Adapter
  def self.use: (adapter_spec new_adapter) -> _Adapter
  def self.adapter=: (adapter_spec new_adapter) -> _Adapter
  def self.engine=: (adapter_spec new_adapter) -> _Adapter
  def self.load: (string_input string, ?options options) -> json
  def self.decode: (string_input string, ?options options) -> json
  def self.current_adapter: (?options? options) -> _Adapter
  def self.dump: (json_input object, ?options options) -> String
  def self.encode: (json_input object, ?options options) -> String
  def self.with_adapter: [T] (adapter_spec new_adapter) { () -> T } -> T
  def self.with_engine: [T] (adapter_spec new_adapter) { () -> T } -> T

  # Instance method declarations for module_function and explicit delegates
  def default_options=: (options_input value) -> options_input
  def default_options: () -> options
  def adapter: () -> _Adapter
  def engine: () -> _Adapter
  def use: (adapter_spec new_adapter) -> _Adapter
  def adapter=: (adapter_spec new_adapter) -> _Adapter
  def engine=: (adapter_spec new_adapter) -> _Adapter
  def load: (string_input string, ?options options) -> json
  def decode: (string_input string, ?options options) -> json
  def current_adapter: (?options? options) -> _Adapter
  def dump: (json_input object, ?options options) -> String
  def encode: (json_input object, ?options options) -> String
  def with_adapter: [T] (adapter_spec new_adapter) { () -> T } -> T

  # Module-level instance variable for adapter caching
  @adapter: _Adapter?

  class Version
    MAJOR: Integer
    MINOR: Integer
    PATCH: Integer
    PRE: String?

    def self.to_s: () -> String
  end

  class AdapterError < ArgumentError
    def initialize: (?String? message, ?cause: Exception?) -> void
    def self.build: (Exception original_exception) -> AdapterError
  end

  class ParseError < StandardError
    LOCATION_PATTERN: Regexp

    # The raw data that failed to parse (string or IO-like object)
    attr_reader data: string_input?

    # 1-based line number extracted from the adapter's error message
    attr_reader line: Integer?

    # 1-based column number extracted from the adapter's error message
    attr_reader column: Integer?

    @data: string_input?
    @line: Integer?
    @column: Integer?

    def initialize: (?String? message, ?data: string_input?, ?cause: Exception?) -> void
    def self.build: (Exception original_exception, string_input data) -> ParseError

    private

    def location_match: (String? message) -> MatchData?
  end

  DecodeError: singleton(ParseError)
  LoadError: singleton(ParseError)

  module Options
    EMPTY_OPTIONS: options

    def load_options=: (options_input value) -> options_input
    def dump_options=: (options_input value) -> options_input
    def load_options: (*options) -> options
    def dump_options: (*options) -> options
    def default_load_options: () -> options
    def default_dump_options: () -> options

    @load_options: options_input?
    @dump_options: options_input?
    @default_load_options: options?
    @default_dump_options: options?

    private

    def resolve_options: (options_input? stored_options, *options) -> options?
    def invoke_callable: (options_proc callable, *options) -> options
  end

  module OptionsCache
    DEFAULT_MAX_CACHE_SIZE: Integer
    BACKENDS: Hash[String, String]

    def self.dump: () -> Store
    def self.load: () -> Store
    def self.reset: () -> void
    def self.max_cache_size: () -> Integer
    def self.max_cache_size=: (Integer value) -> Integer

    self.@dump: Store
    self.@load: Store
    self.@max_cache_size: Integer

    class Store
      def initialize: () -> void
      def reset: () -> void
      def fetch: (options key, ?options? default) ?{ () -> options } -> options?

      @cache: untyped
      @mutex: Mutex
    end
  end

  module AdapterSelector
    extend AdapterSelector

    ADAPTERS: Hash[Symbol, Hash[Symbol, String]]
    REQUIREMENT_MAP: Hash[Symbol, String]

    def default_adapter: () -> Symbol
    def default_adapter_excluding: (Symbol excluded) -> (_Adapter | Module)

    @default_adapter: Symbol?
    @default_adapter_warning_shown: bool?

    private

    def detect_best_adapter: () -> Symbol
    def loaded_adapter: (?excluding: Symbol?) -> Symbol?
    def installable_adapter: (?excluding: Symbol?) -> Symbol?
    def try_require: (Symbol adapter_name) -> bool
    def fallback_adapter: () -> Symbol
    def warn_about_fallback: () -> void
    def load_adapter: (adapter_spec new_adapter) -> (_Adapter | Module)
    def load_adapter_by_name: (String name) -> _Adapter
  end

  class Adapter
    extend Options
    include Singleton

    def self.inherited: (singleton(Adapter) subclass) -> void
    def self.defaults: (:load | :dump action, options value) -> void
    def self.load: (string_input string, ?options options) -> json
    def self.dump: (json_input object, ?options options) -> String

    # Instance methods receive String (after IO conversion in class method)
    def load: (String string, options options) -> json
    def dump: (json_input object, options options) -> String

    private

    def self.blank?: (String? input) -> bool
    def self.merged_dump_options: (options options) -> options?
    def self.merged_load_options: (options options) -> options?
    def self.strip_adapter_key: (options options) -> options

    BLANK_PATTERN: Regexp
    VALID_DEFAULTS_ACTIONS: Array[Symbol]
  end

  module Adapters
    class Yajl < Adapter
      ParseError: untyped

      def load: (String string, options options) -> untyped
      def dump: (json_input object, options options) -> String
    end

    class JrJackson < Adapter
      ParseError: untyped

      def load: (String string, options options) -> untyped
      def dump: (json_input object, options options) -> String
    end

    class Gson < Adapter
      ParseError: untyped

      def load: (String string, options options) -> untyped
      def dump: (json_input object, options options) -> String
    end
  end
end
