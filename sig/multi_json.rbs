module MultiJSON
  VERSION: String

  module Concurrency
    MUTEXES: Hash[Symbol, Mutex]

    def self.synchronize: [T] (Symbol name) { () -> T } -> T
  end

  extend Options
  extend AdapterSelector
  extend AdapterOverrides
  extend AdapterStateHelpers

  # JSON value type - what parse() returns
  type json = nil | bool | Integer | Float | String | Array[json] | Hash[String, json]

  # JSON-serializable input type - what generate() accepts
  type json_input = nil | bool | Integer | Float | String | Symbol | Array[json_input] | Hash[json_key, json_input] | _ToJson

  # Valid hash key types for JSON input
  type json_key = String | Symbol

  # Options hash type
  type options = Hash[Symbol, bool | String | Symbol | Integer | Module | nil]

  # Adapter specification - can be symbol, module, or nil/false for default
  type adapter_spec = Symbol | Module | nil | false
  type directional_adapter_spec = Hash[Symbol, adapter_spec]

  # String or IO-like object for parse input
  type string_input = String | _Readable

  interface _Readable
    def read: () -> String
  end

  interface _ToJson
    def as_json: () -> json_input
  end

  interface _Adapter
    def parse: (string_input string, options options) -> json
    def generate: (json_input object, options options) -> String
  end

  def self.parse_error_class_for: (untyped adapter_class) -> untyped

  def self.adapter: () -> (_Adapter | Module)
  def self.parse_adapter: () -> (_Adapter | Module)
  def self.generate_adapter: () -> (_Adapter | Module)
  def self.use: (adapter_spec new_adapter) -> (_Adapter | Module)
  def self.adapter=: (adapter_spec new_adapter) -> (_Adapter | Module)
  def self.parse_adapter=: (adapter_spec new_adapter) -> (_Adapter | Module)
  def self.generate_adapter=: (adapter_spec new_adapter) -> (_Adapter | Module)
  def self.parse: (string_input string, ?symbolize_names: bool, ?adapter: adapter_spec, **untyped opts) -> json
  def self.current_adapter: (?Hash[Symbol, untyped]? options, ?adapter: adapter_spec, **untyped kwargs) -> (_Adapter | Module)
  def self.current_parse_adapter: (?Hash[Symbol, untyped]? options, ?adapter: adapter_spec, **untyped _opts) -> (_Adapter | Module)
  def self.current_generate_adapter: (?Hash[Symbol, untyped]? options, ?adapter: adapter_spec, **untyped _opts) -> (_Adapter | Module)
  def self.generate: (json_input object, ?pretty: bool, ?adapter: adapter_spec, **untyped opts) -> String
  def self.with_adapter: [T] ((adapter_spec | directional_adapter_spec) new_adapter) { () -> T } -> T

  self.@adapter: (_Adapter | Module)?
  self.@parse_adapter: (_Adapter | Module)?
  self.@generate_adapter: (_Adapter | Module)?

  class Version
    MAJOR: Integer
    MINOR: Integer
    PATCH: Integer
    PRE: String?

    def self.to_s: () -> String
  end

  class AdapterError < ArgumentError
    def initialize: (?String? message, ?cause: Exception?) -> void
    def self.build: (Exception original_exception) -> AdapterError
  end

  class ParseError < StandardError
    LOCATION_PATTERN: Regexp

    attr_reader data: string_input?
    attr_reader line: Integer?
    attr_reader column: Integer?

    @data: string_input?
    @line: Integer?
    @column: Integer?

    def initialize: (?String? message, ?data: string_input?, ?cause: Exception?) -> void
    def self.build: (Exception original_exception, string_input data) -> ParseError

    private

    def location_match: (String? message) -> MatchData?
  end
  module Options
    EMPTY_OPTIONS: options

    def parse_options=: (options? value) -> options?
    def generate_options=: (options? value) -> options?
    def parse_options: () -> options
    def generate_options: () -> options
    def default_parse_options: () -> options
    def default_generate_options: () -> options

    @parse_options: options?
    @generate_options: options?
    @default_parse_options: options?
    @default_generate_options: options?
  end

  module OptionsCache
    DEFAULT_MAX_CACHE_SIZE: Integer
    BACKENDS: Hash[String, String]

    def self.generate: () -> Store
    def self.parse: () -> Store
    def self.reset: () -> void
    def self.max_cache_size: () -> Integer
    def self.max_cache_size=: (Integer value) -> Integer

    self.@generate: Store
    self.@parse: Store
    self.@max_cache_size: Integer

    class Store
      def initialize: () -> void
      def reset: () -> void
      def fetch: (options key) { () -> options } -> options
               | (options key, ?options? default) -> options?

      @cache: untyped
      @mutex: Mutex
    end
  end

  module AdapterSelector
    extend AdapterSelector

    ADAPTERS: Hash[Symbol, Hash[Symbol, String]]
    REQUIREMENT_MAP: Hash[Symbol, String]
    PARSE_ADAPTERS: Array[Symbol]
    GENERATE_ADAPTERS: Array[Symbol]

    def default_adapter: () -> Symbol
    def default_parse_adapter: () -> Symbol
    def default_generate_adapter: () -> Symbol
    def default_adapter_excluding: (Symbol excluded, ?operation: Symbol) -> (_Adapter | Module)

    @default_adapter: Symbol?
    @default_parse_adapter: Symbol?
    @default_generate_adapter: Symbol?
    @default_adapter_warning_shown: bool?

    private

    def detect_best_adapter: (Symbol operation) -> Symbol
    def loaded_adapter: (?Array[Symbol]? preferences, ?excluding: Symbol?) -> Symbol?
    def installable_adapter: (?Array[Symbol]? preferences, ?excluding: Symbol?) -> Symbol?
    def try_require: (Symbol adapter_name) -> bool
    def fallback_adapter: () -> Symbol
    def warn_about_fallback: () -> void
    def adapter_preferences: (Symbol operation) -> Array[Symbol]
    def default_adapter_for: (Symbol operation) -> Symbol
    def cached_default_adapter_for: (Symbol operation, Symbol ivar) -> Symbol?
    def detect_and_cache_default_adapter: (Symbol operation, Symbol ivar) -> Symbol
    def load_adapter: (adapter_spec new_adapter) -> (_Adapter | Module)
    def load_adapter_by_name: (String name) -> _Adapter
    def validate_adapter!: ((_Adapter | Module) adapter) -> (_Adapter | Module)
  end

  module AdapterOverrides
    def with_adapter: [T] ((adapter_spec | directional_adapter_spec) new_adapter) { () -> T } -> T

    private

    def apply_adapter_override: ((adapter_spec | directional_adapter_spec) new_adapter, (_Adapter | Module)? previous_parse_override, (_Adapter | Module)? previous_generate_override) -> void
    def apply_directional_override: (directional_adapter_spec new_adapter, (_Adapter | Module)? previous_parse_override, (_Adapter | Module)? previous_generate_override) -> void
    def apply_default_override: () -> void
    def override_adapter_for: (directional_adapter_spec new_adapter, Symbol key, Symbol default_adapter, (_Adapter | Module)? previous_override) -> (_Adapter | Module)?
  end

  module AdapterStateHelpers
    @adapter: (_Adapter | Module)?
    @parse_adapter: (_Adapter | Module)?
    @generate_adapter: (_Adapter | Module)?

    private

    def resolve_adapter_or_default: (adapter_spec new_adapter, Symbol operation) -> (_Adapter | Module)
    def default_adapter_name_for: (Symbol operation) -> Symbol
    def default_adapter_spec?: (untyped adapter_spec) -> bool
    def store_directional_adapters: ((_Adapter | Module) parse_loaded, (_Adapter | Module) generate_loaded) -> (_Adapter | Module)
    def store_parse_adapter: ((_Adapter | Module) loaded) -> (_Adapter | Module)
    def store_generate_adapter: ((_Adapter | Module) loaded) -> (_Adapter | Module)
    def shared_adapter: (((_Adapter | Module)?) left, ((_Adapter | Module)?) right) -> ((_Adapter | Module)?)
  end

  class Adapter
    extend Options

    def self.default_parse_options: () -> options
    def self.default_generate_options: () -> options
    def self.defaults: (:parse | :generate action, options value) -> void
    def self.parse: (string_input string, ?options options) -> json
    def self.generate: (json_input object, ?options options) -> String

    private

    def self._parse: (String string, options options) -> json
    def self._generate: (json_input object, options options) -> String
    def self.walk_default_options: (Symbol ivar) -> options
    def self.blank?: (String input) -> bool
    def self.merged_generate_options: (options options) -> options
    def self.merged_parse_options: (options options) -> options
    def self.strip_adapter_key: (options options) -> options

    BLANK_PATTERN: Regexp
    VALID_DEFAULTS_ACTIONS: Array[Symbol]
  end

  module Adapters
    class Yajl < Adapter
      ParseError: untyped

      private

      def self._parse: (String string, options options) -> untyped
      def self._generate: (json_input object, options options) -> String
    end

    class JrJackson < Adapter
      ParseError: untyped

      private

      def self._parse: (String string, options options) -> untyped
      def self._generate: (json_input object, options options) -> String
      def self.translate_parse_options: (options options) -> options
    end

    class Gson < Adapter
      ParseError: untyped
      DEFAULT_DECODER: untyped
      DEFAULT_ENCODER: untyped

      private

      def self._parse: (String string, options options) -> untyped
      def self._generate: (json_input object, options options) -> String
      def self.translate_parse_options: (options options) -> options
    end
  end
end
